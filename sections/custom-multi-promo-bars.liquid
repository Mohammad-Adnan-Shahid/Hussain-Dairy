{%- comment -%}
  Custom Multi-Promo Bars Section
  Features 4 promotional modules:
  1. Top Announcement Bar (Static repeating strip)
  2. Sub-Header Promo Bar (Marquee framed by '<' & '>' arrows)
  3. Trust Badges Bar (3 columns with icons, headings, vertical divider borders)
  4. Bottom Scrolling Bar (High-density marquee)
{%- endcomment -%}

{%- liquid
  assign sub_blocks = section.blocks | where: 'type', 'marquee_text_sub'
  assign bottom_blocks = section.blocks | where: 'type', 'marquee_text_bottom'
-%}

<style>
  #shopify-section-{{ section.id }} .custom-pbar__root {
    --cpb-top-bg: {{ section.settings.top_bar_bg }};
    --cpb-top-text: {{ section.settings.top_bar_text_color }};
    --cpb-sub-bg: {{ section.settings.sub_header_bg }};
    --cpb-sub-text: {{ section.settings.sub_header_text_color }};
    --cpb-sub-speed: {{ section.settings.sub_header_speed }}s;
    --cpb-trust-bg: {{ section.settings.trust_badges_bg }};
    --cpb-trust-text: {{ section.settings.trust_badges_text_color }};
    --cpb-trust-border: {{ section.settings.trust_badges_border_color }};
    --cpb-bottom-bg: {{ section.settings.bottom_bar_bg }};
    --cpb-bottom-text: {{ section.settings.bottom_bar_text_color }};
    --cpb-bottom-speed: {{ section.settings.bottom_bar_speed }}s;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* ----------------------------------------
     1. TOP ANNOUNCEMENT BAR
     ---------------------------------------- */
  .custom-pbar__top {
    background-color: var(--cpb-top-bg);
    color: var(--cpb-top-text);
    width: 100%;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    overflow: hidden;
  }

  .custom-pbar__top-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .custom-pbar__top-link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: opacity 0.2s ease;
  }

  .custom-pbar__top-link:hover {
    opacity: 0.85;
  }

  .custom-pbar__top-repeater {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .custom-pbar__top-dot {
    opacity: 0.5;
    font-size: 10px;
    line-height: 1;
  }

  /* ----------------------------------------
     2. SUB-HEADER PROMO BAR
     ---------------------------------------- */
  .custom-pbar__sub {
    background-color: var(--cpb-sub-bg);
    color: var(--cpb-sub-text);
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    padding: 7px 0;
  }

  .custom-pbar__sub-arrow {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
    background: var(--cpb-sub-bg);
    color: var(--cpb-sub-text);
  }

  .custom-pbar__sub-arrow--left {
    left: 0;
    box-shadow: 6px 0 12px -2px var(--cpb-sub-bg);
  }

  .custom-pbar__sub-arrow--right {
    right: 0;
    box-shadow: -6px 0 12px -2px var(--cpb-sub-bg);
  }

  .custom-pbar__sub-arrow svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .custom-pbar__sub-marquee-wrap {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 0 44px;
  }

  .custom-pbar__sub-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: custom-pbar-scroll-sub var(--cpb-sub-speed) linear infinite;
    will-change: transform;
  }

  .custom-pbar__sub-track:hover {
    animation-play-state: paused;
  }

  .custom-pbar__sub-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .custom-pbar__sub-item {
    display: inline-flex;
    align-items: center;
    padding: 0 28px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--cpb-sub-text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .custom-pbar__sub-item:hover {
    opacity: 0.75;
  }

  .custom-pbar__sub-separator {
    display: inline-block;
    margin-left: 28px;
    opacity: 0.45;
    font-weight: 400;
    font-size: 11px;
  }

  @keyframes custom-pbar-scroll-sub {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ----------------------------------------
     3. TRUST BADGES BAR
     ---------------------------------------- */
  .custom-pbar__trust {
    background-color: var(--cpb-trust-bg);
    color: var(--cpb-trust-text);
    width: 100%;
    border-top: 1px solid var(--cpb-trust-border);
    border-bottom: 1px solid var(--cpb-trust-border);
    padding: 16px 20px;
  }

  .custom-pbar__trust-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .custom-pbar__trust-col {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 8px 18px;
    text-align: left;
  }

  .custom-pbar__trust-col:not(:last-child) {
    border-right: 1px solid var(--cpb-trust-border);
  }

  .custom-pbar__trust-icon-box {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
  }

  .custom-pbar__trust-icon-box svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  .custom-pbar__trust-icon-box svg.stroke-based {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .custom-pbar__trust-text {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.01em;
    margin: 0;
  }

  /* ----------------------------------------
     4. BOTTOM SCROLLING BAR
     ---------------------------------------- */
  .custom-pbar__bottom {
    background-color: var(--cpb-bottom-bg);
    color: var(--cpb-bottom-text);
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 12px 0;
  }

  .custom-pbar__bottom-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: custom-pbar-scroll-bottom var(--cpb-bottom-speed) linear infinite;
    will-change: transform;
  }

  .custom-pbar__bottom-track:hover {
    animation-play-state: paused;
  }

  .custom-pbar__bottom-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .custom-pbar__bottom-item {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 0 20px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cpb-bottom-text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .custom-pbar__bottom-item:hover {
    opacity: 0.8;
  }

  .custom-pbar__bottom-glyph {
    display: inline-block;
    font-size: 11px;
    opacity: 0.7;
    margin-left: 20px;
    color: currentColor;
  }

  @keyframes custom-pbar-scroll-bottom {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ----------------------------------------
     RESPONSIVE (MOBILE & TABLET)
     ---------------------------------------- */
  @media screen and (max-width: 768px) {
    .custom-pbar__top {
      font-size: 11.5px;
      padding: 7px 12px;
    }

    .custom-pbar__top-repeater {
      gap: 14px;
    }

    .custom-pbar__sub {
      padding: 6px 0;
    }

    .custom-pbar__sub-arrow {
      width: 32px;
    }

    .custom-pbar__sub-arrow svg {
      width: 12px;
      height: 12px;
    }

    .custom-pbar__sub-marquee-wrap {
      padding: 0 32px;
    }

    .custom-pbar__sub-item {
      font-size: 12px;
      padding: 0 16px;
    }

    .custom-pbar__sub-separator {
      margin-left: 16px;
    }

    .custom-pbar__trust {
      padding: 12px 14px;
    }

    .custom-pbar__trust-container {
      flex-direction: column;
      gap: 10px;
    }

    .custom-pbar__trust-col {
      width: 100%;
      padding: 8px 10px;
      justify-content: flex-start;
    }

    .custom-pbar__trust-col:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid var(--cpb-trust-border);
      padding-bottom: 10px;
    }

    .custom-pbar__trust-icon-box {
      width: 30px;
      height: 30px;
    }

    .custom-pbar__trust-icon-box svg {
      width: 22px;
      height: 22px;
    }

    .custom-pbar__trust-text {
      font-size: 13px;
    }

    .custom-pbar__bottom {
      padding: 9px 0;
    }

    .custom-pbar__bottom-item {
      font-size: 11.5px;
      padding: 0 14px;
      gap: 14px;
    }

    .custom-pbar__bottom-glyph {
      margin-left: 14px;
      font-size: 9px;
    }
  }
</style>

<div class="custom-pbar__root" data-section-id="{{ section.id }}">

  {%- comment -%} ==========================================
      1. TOP ANNOUNCEMENT BAR
      ========================================== {%- endcomment -%}
  {%- if section.settings.top_bar_enabled and section.settings.top_bar_text != blank -%}
    <aside class="custom-pbar__top" aria-label="Announcement">
      <div class="custom-pbar__top-inner">
        {%- if section.settings.top_bar_link != blank -%}
          <a href="{{ section.settings.top_bar_link }}" class="custom-pbar__top-link">
        {%- endif -%}

          <div class="custom-pbar__top-repeater">
            <span>{{ section.settings.top_bar_text }}</span>
            {%- if section.settings.top_bar_repeat -%}
              <span class="custom-pbar__top-dot" aria-hidden="true">•</span>
              <span>{{ section.settings.top_bar_text }}</span>
              <span class="custom-pbar__top-dot" aria-hidden="true">•</span>
              <span>{{ section.settings.top_bar_text }}</span>
            {%- endif -%}
          </div>

        {%- if section.settings.top_bar_link != blank -%}
          </a>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  {%- comment -%} ==========================================
      2. SUB-HEADER PROMO BAR
      ========================================== {%- endcomment -%}
  {%- if section.settings.sub_header_enabled and sub_blocks.size > 0 -%}
    <div class="custom-pbar__sub" aria-label="Highlights">
      <div class="custom-pbar__sub-arrow custom-pbar__sub-arrow--left" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </div>

      <div class="custom-pbar__sub-marquee-wrap">
        <div class="custom-pbar__sub-track">
          {%- comment -%} Group 1 {%- endcomment -%}
          <div class="custom-pbar__sub-group">
            {%- for i in (1..3) -%}
              {%- for block in sub_blocks -%}
                {%- if block.settings.text != blank -%}
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="custom-pbar__sub-item" {{ block.shopify_attributes }}>
                      <span>{{ block.settings.text }}</span>
                      <span class="custom-pbar__sub-separator" aria-hidden="true">✦</span>
                    </a>
                  {%- else -%}
                    <span class="custom-pbar__sub-item" {{ block.shopify_attributes }}>
                      <span>{{ block.settings.text }}</span>
                      <span class="custom-pbar__sub-separator" aria-hidden="true">✦</span>
                    </span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Group 2 (Duplicate for continuous seamless loop) {%- endcomment -%}
          <div class="custom-pbar__sub-group" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- for block in sub_blocks -%}
                {%- if block.settings.text != blank -%}
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" tabindex="-1" class="custom-pbar__sub-item">
                      <span>{{ block.settings.text }}</span>
                      <span class="custom-pbar__sub-separator">✦</span>
                    </a>
                  {%- else -%}
                    <span class="custom-pbar__sub-item">
                      <span>{{ block.settings.text }}</span>
                      <span class="custom-pbar__sub-separator">✦</span>
                    </span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="custom-pbar__sub-arrow custom-pbar__sub-arrow--right" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ==========================================
      3. TRUST BADGES BAR
      ========================================== {%- endcomment -%}
  {%- if section.settings.trust_badges_enabled -%}
    <div class="custom-pbar__trust">
      <div class="custom-pbar__trust-container">

        {%- comment -%} Column 1 {%- endcomment -%}
        {%- if section.settings.trust_heading_1 != blank -%}
          <div class="custom-pbar__trust-col">
            <div class="custom-pbar__trust-icon-box">
              {%- case section.settings.trust_icon_1 -%}
                {%- when 'shield' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- when 'traditional' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {%- when 'heart' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'leaf' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- when 'truck' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- else -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              {%- endcase -%}
            </div>
            <p class="custom-pbar__trust-text">{{ section.settings.trust_heading_1 }}</p>
          </div>
        {%- endif -%}

        {%- comment -%} Column 2 {%- endcomment -%}
        {%- if section.settings.trust_heading_2 != blank -%}
          <div class="custom-pbar__trust-col">
            <div class="custom-pbar__trust-icon-box">
              {%- case section.settings.trust_icon_2 -%}
                {%- when 'shield' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- when 'traditional' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {%- when 'heart' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'leaf' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- when 'truck' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- else -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              {%- endcase -%}
            </div>
            <p class="custom-pbar__trust-text">{{ section.settings.trust_heading_2 }}</p>
          </div>
        {%- endif -%}

        {%- comment -%} Column 3 {%- endcomment -%}
        {%- if section.settings.trust_heading_3 != blank -%}
          <div class="custom-pbar__trust-col">
            <div class="custom-pbar__trust-icon-box">
              {%- case section.settings.trust_icon_3 -%}
                {%- when 'shield' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- when 'traditional' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {%- when 'heart' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'leaf' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- when 'truck' -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- else -%}
                  <svg class="stroke-based" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- endcase -%}
            </div>
            <p class="custom-pbar__trust-text">{{ section.settings.trust_heading_3 }}</p>
          </div>
        {%- endif -%}

      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ==========================================
      4. BOTTOM SCROLLING BAR
      ========================================== {%- endcomment -%}
  {%- if section.settings.bottom_bar_enabled and bottom_blocks.size > 0 -%}
    <div class="custom-pbar__bottom" aria-label="Store highlights">
      <div class="custom-pbar__bottom-track">
        {%- comment -%} Group 1 {%- endcomment -%}
        <div class="custom-pbar__bottom-group">
          {%- for i in (1..3) -%}
            {%- for block in bottom_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="custom-pbar__bottom-item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    <span class="custom-pbar__bottom-glyph" aria-hidden="true">◆</span>
                  </a>
                {%- else -%}
                  <span class="custom-pbar__bottom-item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    <span class="custom-pbar__bottom-glyph" aria-hidden="true">◆</span>
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Group 2 (Duplicate for seamless continuous loop) {%- endcomment -%}
        <div class="custom-pbar__bottom-group" aria-hidden="true">
          {%- for i in (1..3) -%}
            {%- for block in bottom_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" tabindex="-1" class="custom-pbar__bottom-item">
                    <span>{{ block.settings.text }}</span>
                    <span class="custom-pbar__bottom-glyph">◆</span>
                  </a>
                {%- else -%}
                  <span class="custom-pbar__bottom-item">
                    <span>{{ block.settings.text }}</span>
                    <span class="custom-pbar__bottom-glyph">◆</span>
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

