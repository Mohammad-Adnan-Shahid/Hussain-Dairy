{%- comment -%}
  Custom Scrolling Announcement Bar
  Ultra-customizable horizontal continuous scrolling marquee ticker.
  Features:
  - Banner size (vertical padding / height)
  - Text size (desktop & mobile)
  - Font family (Theme Body or Heading) & Font weight (400-800)
  - Text transform & letter spacing
  - Background color & Text/Separator color
  - Ultra-slow speed controls (10s to 240s)
  - Scroll direction & Pause on hover
  - Item spacing gap & Separator symbol
{%- endcomment -%}

{%- liquid
  assign bar_blocks = section.blocks | where: 'type', 'scrolling_text'
  if bar_blocks.size == 0
    # Fallback to old block name if merchant had blocks added previously
    assign bar_blocks = section.blocks
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .custom-sb__wrapper {
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  .custom-sb-{{ section.id }} .custom-sb__bar,
  #shopify-section-{{ section.id }} .custom-sb__bar {
    --csb-bg: {{ section.settings.bar_bg }};
    --csb-text: {{ section.settings.bar_text_color }};
    --csb-pad: {{ section.settings.bar_padding }}px;
    --csb-gap: {{ section.settings.bar_gap }}px;
    --csb-fsize-desktop: {{ section.settings.bar_font_size }}px;
    --csb-fsize-mobile: {{ section.settings.bar_font_size_mobile }}px;
    --csb-fweight: {{ section.settings.bar_font_weight }};
    --csb-lspacing: {{ section.settings.bar_letter_spacing }}px;
    --csb-ttransform: {{ section.settings.bar_text_transform }};
    --csb-speed: {{ section.settings.bar_speed }}s;
    background-color: var(--csb-bg);
    color: var(--csb-text);
    padding: var(--csb-pad) 0;
    width: 100%;
    overflow: hidden;
    position: relative;
    {%- if section.settings.bar_font_family == 'heading' -%}
      font-family: var(--font-heading-family, inherit);
    {%- else -%}
      font-family: var(--font-body-family, inherit);
    {%- endif -%}
  }

  .custom-sb-{{ section.id }} .custom-sb__track,
  #shopify-section-{{ section.id }} .custom-sb__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    animation: custom-sb-scroll var(--csb-speed) linear infinite;
    {%- if section.settings.bar_direction == 'reverse' -%}
      animation-direction: reverse;
    {%- endif -%}
  }

  {%- if section.settings.bar_pause_hover -%}
    #shopify-section-{{ section.id }} .custom-sb__bar:hover .custom-sb__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  .custom-sb-{{ section.id }} .custom-sb__group,
  #shopify-section-{{ section.id }} .custom-sb__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .custom-sb-{{ section.id }} .custom-sb__item,
  #shopify-section-{{ section.id }} .custom-sb__item {
    display: inline-flex;
    align-items: center;
    gap: var(--csb-gap);
    padding: 0 calc(var(--csb-gap) / 2);
    font-size: var(--csb-fsize-desktop);
    font-weight: var(--csb-fweight);
    letter-spacing: var(--csb-lspacing);
    text-transform: var(--csb-ttransform);
    color: var(--csb-text);
    text-decoration: none;
    line-height: 1.25;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .custom-sb__item:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .custom-sb__separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--csb-text);
    opacity: 0.7;
    font-size: 0.85em;
  }

  @keyframes custom-sb-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 768px) {
    .custom-sb-{{ section.id }} .custom-sb__item,
  #shopify-section-{{ section.id }} .custom-sb__item {
      font-size: var(--csb-fsize-mobile);
    }
  }
</style>

<div class="custom-sb__wrapper custom-sb-{{ section.id }}" id="custom-sb-{{ section.id }}">
  {%- if section.settings.bar_enabled and bar_blocks.size > 0 -%}
    {%- liquid
      # Calculate repeat count so single phrase or few items seamlessly fill wide viewports
      assign repeat_count = 6
      if bar_blocks.size > 4
        assign repeat_count = 2
      elsif bar_blocks.size > 2
        assign repeat_count = 4
      endif
    -%}
    <div class="custom-sb__bar" aria-label="Scrolling Announcement Bar">
      <div class="custom-sb__track">
        {%- comment -%} Group 1 {%- endcomment -%}
        <div class="custom-sb__group">
          {%- for r in (1..repeat_count) -%}
            {%- for block in bar_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="custom-sb__item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_separator != 'none' -%}
                      <span class="custom-sb__separator" aria-hidden="true">
                        {%- case section.settings.bar_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="custom-sb__item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_separator != 'none' -%}
                      <span class="custom-sb__separator" aria-hidden="true">
                        {%- case section.settings.bar_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Group 2 (Continuous loop duplicate) {%- endcomment -%}
        <div class="custom-sb__group" aria-hidden="true">
          {%- for r in (1..repeat_count) -%}
            {%- for block in bar_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" tabindex="-1" class="custom-sb__item">
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_separator != 'none' -%}
                      <span class="custom-sb__separator">
                        {%- case section.settings.bar_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="custom-sb__item">
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_separator != 'none' -%}
                      <span class="custom-sb__separator">
                        {%- case section.settings.bar_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Scrolling Bar",
  "tag": "section",
  "class": "section-custom-scrolling-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "bar_enabled",
      "label": "Enable Scrolling Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bar_bg",
      "label": "Banner Background Color",
      "default": "#1b3b22"
    },
    {
      "type": "color",
      "id": "bar_text_color",
      "label": "Text & Separator Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bar_padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Banner Size (Vertical Padding)",
      "default": 10
    },
    {
      "type": "range",
      "id": "bar_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Desktop Text Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "bar_font_size_mobile",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile Text Size",
      "default": 11
    },
    {
      "type": "select",
      "id": "bar_font_family",
      "label": "Font Family",
      "options": [
        { "value": "body", "label": "Theme Body Font" },
        { "value": "heading", "label": "Theme Heading Font" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "bar_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra-Bold (800)" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "bar_text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "none", "label": "Normal (As typed)" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize Each Word" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "bar_letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "bar_speed",
      "min": 10,
      "max": 240,
      "step": 5,
      "unit": "s",
      "label": "Marquee Speed Duration (Higher = Slower)",
      "default": 80
    },
    {
      "type": "select",
      "id": "bar_direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "normal", "label": "Right to Left (Standard)" },
        { "value": "reverse", "label": "Left to Right" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "bar_pause_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_gap",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 40
    },
    {
      "type": "select",
      "id": "bar_separator",
      "label": "Separator Symbol",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "dot", "label": "Dot (•)" },
        { "value": "diamond", "label": "Diamond (◆)" },
        { "value": "star", "label": "Star (★)" },
        { "value": "slash", "label": "Slash (/)" },
        { "value": "dash", "label": "Dash (—)" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "scrolling_text",
      "name": "Scrolling Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over PKR 4,000"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Scrolling Bar",
      "blocks": [
        {
          "type": "scrolling_text",
          "settings": {
            "text": "Free shipping on orders over PKR 4,000"
          }
        }
      ]
    }
  ]
}
{% endschema %}
