{%- comment -%}
  Custom Dual Scrolling Marquee Bars
  Provides two independent, ultra-customizable horizontal scrolling tickers.
  Customizations for each bar:
  - Banner size (vertical padding / height)
  - Text size (desktop & mobile)
  - Font family (Body or Heading) & Font weight (400-800)
  - Text transform & letter spacing
  - Background color & Text/Separator color
  - Ultra-slow speed controls (10s to 240s)
  - Scroll direction & Pause on hover
  - Item spacing gap & Separator symbol
{%- endcomment -%}

{%- liquid
  assign bar_1_blocks = section.blocks | where: 'type', 'bar_1_text'
  assign bar_2_blocks = section.blocks | where: 'type', 'bar_2_text'
-%}

<style>
  #shopify-section-{{ section.id }} .custom-sb__wrapper {
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* ========================================================
     BAR 1 STYLING
     ======================================================== */
  #shopify-section-{{ section.id }} .custom-sb__bar--1 {
    --csb-bg-1: {{ section.settings.bar_1_bg }};
    --csb-text-1: {{ section.settings.bar_1_text_color }};
    --csb-pad-1: {{ section.settings.bar_1_padding }}px;
    --csb-gap-1: {{ section.settings.bar_1_gap }}px;
    --csb-fsize-desktop-1: {{ section.settings.bar_1_font_size }}px;
    --csb-fsize-mobile-1: {{ section.settings.bar_1_font_size_mobile }}px;
    --csb-fweight-1: {{ section.settings.bar_1_font_weight }};
    --csb-lspacing-1: {{ section.settings.bar_1_letter_spacing }}px;
    --csb-ttransform-1: {{ section.settings.bar_1_text_transform }};
    --csb-speed-1: {{ section.settings.bar_1_speed }}s;
    background-color: var(--csb-bg-1);
    color: var(--csb-text-1);
    padding: var(--csb-pad-1) 0;
    width: 100%;
    overflow: hidden;
    position: relative;
    {%- if section.settings.bar_1_font_family == 'heading' -%}
      font-family: var(--font-heading-family, inherit);
    {%- else -%}
      font-family: var(--font-body-family, inherit);
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--1 .custom-sb__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    animation: custom-sb-scroll var(--csb-speed-1) linear infinite;
    {%- if section.settings.bar_1_direction == 'reverse' -%}
      animation-direction: reverse;
    {%- endif -%}
  }

  {%- if section.settings.bar_1_pause_hover -%}
    #shopify-section-{{ section.id }} .custom-sb__bar--1:hover .custom-sb__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .custom-sb__bar--1 .custom-sb__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--1 .custom-sb__item {
    display: inline-flex;
    align-items: center;
    gap: var(--csb-gap-1);
    padding: 0 calc(var(--csb-gap-1) / 2);
    font-size: var(--csb-fsize-desktop-1);
    font-weight: var(--csb-fweight-1);
    letter-spacing: var(--csb-lspacing-1);
    text-transform: var(--csb-ttransform-1);
    color: var(--csb-text-1);
    text-decoration: none;
    line-height: 1.25;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--1 .custom-sb__item:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--1 .custom-sb__separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--csb-text-1);
    opacity: 0.7;
    font-size: 0.85em;
  }

  /* ========================================================
     BAR 2 STYLING
     ======================================================== */
  #shopify-section-{{ section.id }} .custom-sb__bar--2 {
    --csb-bg-2: {{ section.settings.bar_2_bg }};
    --csb-text-2: {{ section.settings.bar_2_text_color }};
    --csb-pad-2: {{ section.settings.bar_2_padding }}px;
    --csb-gap-2: {{ section.settings.bar_2_gap }}px;
    --csb-fsize-desktop-2: {{ section.settings.bar_2_font_size }}px;
    --csb-fsize-mobile-2: {{ section.settings.bar_2_font_size_mobile }}px;
    --csb-fweight-2: {{ section.settings.bar_2_font_weight }};
    --csb-lspacing-2: {{ section.settings.bar_2_letter_spacing }}px;
    --csb-ttransform-2: {{ section.settings.bar_2_text_transform }};
    --csb-speed-2: {{ section.settings.bar_2_speed }}s;
    background-color: var(--csb-bg-2);
    color: var(--csb-text-2);
    padding: var(--csb-pad-2) 0;
    width: 100%;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    {%- if section.settings.bar_2_font_family == 'heading' -%}
      font-family: var(--font-heading-family, inherit);
    {%- else -%}
      font-family: var(--font-body-family, inherit);
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--2 .custom-sb__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    animation: custom-sb-scroll var(--csb-speed-2) linear infinite;
    {%- if section.settings.bar_2_direction == 'reverse' -%}
      animation-direction: reverse;
    {%- endif -%}
  }

  {%- if section.settings.bar_2_pause_hover -%}
    #shopify-section-{{ section.id }} .custom-sb__bar--2:hover .custom-sb__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .custom-sb__bar--2 .custom-sb__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--2 .custom-sb__item {
    display: inline-flex;
    align-items: center;
    gap: var(--csb-gap-2);
    padding: 0 calc(var(--csb-gap-2) / 2);
    font-size: var(--csb-fsize-desktop-2);
    font-weight: var(--csb-fweight-2);
    letter-spacing: var(--csb-lspacing-2);
    text-transform: var(--csb-ttransform-2);
    color: var(--csb-text-2);
    text-decoration: none;
    line-height: 1.25;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--2 .custom-sb__item:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .custom-sb__bar--2 .custom-sb__separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--csb-text-2);
    opacity: 0.7;
    font-size: 0.85em;
  }

  /* ========================================================
     ANIMATION KEYFRAMES (HARDWARE-ACCELERATED)
     ======================================================== */
  @keyframes custom-sb-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ========================================================
     RESPONSIVE (MOBILE)
     ======================================================== */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .custom-sb__bar--1 .custom-sb__item {
      font-size: var(--csb-fsize-mobile-1);
    }
    #shopify-section-{{ section.id }} .custom-sb__bar--2 .custom-sb__item {
      font-size: var(--csb-fsize-mobile-2);
    }
  }
</style>

<div class="custom-sb__wrapper">

  {%- comment -%} ========================================================
      SCROLLING BAR 1
      ======================================================== {%- endcomment -%}
  {%- if section.settings.bar_1_enabled and bar_1_blocks.size > 0 -%}
    {%- liquid
      # Calculate repeat factor so single items or small lists fill any widescreen seamlessly
      assign repeat_count_1 = 6
      if bar_1_blocks.size > 4
        assign repeat_count_1 = 2
      elsif bar_1_blocks.size > 2
        assign repeat_count_1 = 4
      endif
    -%}
    <div class="custom-sb__bar custom-sb__bar--1" aria-label="Scrolling Announcement Bar 1">
      <div class="custom-sb__track">
        {%- comment -%} Group 1 {%- endcomment -%}
        <div class="custom-sb__group">
          {%- for r in (1..repeat_count_1) -%}
            {%- for block in bar_1_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="custom-sb__item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_1_separator != 'none' -%}
                      <span class="custom-sb__separator" aria-hidden="true">
                        {%- case section.settings.bar_1_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="custom-sb__item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_1_separator != 'none' -%}
                      <span class="custom-sb__separator" aria-hidden="true">
                        {%- case section.settings.bar_1_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Group 2 (Continuous loop duplicate) {%- endcomment -%}
        <div class="custom-sb__group" aria-hidden="true">
          {%- for r in (1..repeat_count_1) -%}
            {%- for block in bar_1_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" tabindex="-1" class="custom-sb__item">
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_1_separator != 'none' -%}
                      <span class="custom-sb__separator">
                        {%- case section.settings.bar_1_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="custom-sb__item">
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_1_separator != 'none' -%}
                      <span class="custom-sb__separator">
                        {%- case section.settings.bar_1_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ========================================================
      SCROLLING BAR 2
      ======================================================== {%- endcomment -%}
  {%- if section.settings.bar_2_enabled and bar_2_blocks.size > 0 -%}
    {%- liquid
      # Calculate repeat factor so single items or small lists fill any widescreen seamlessly
      assign repeat_count_2 = 6
      if bar_2_blocks.size > 4
        assign repeat_count_2 = 2
      elsif bar_2_blocks.size > 2
        assign repeat_count_2 = 4
      endif
    -%}
    <div class="custom-sb__bar custom-sb__bar--2" aria-label="Scrolling Announcement Bar 2">
      <div class="custom-sb__track">
        {%- comment -%} Group 1 {%- endcomment -%}
        <div class="custom-sb__group">
          {%- for r in (1..repeat_count_2) -%}
            {%- for block in bar_2_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="custom-sb__item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_2_separator != 'none' -%}
                      <span class="custom-sb__separator" aria-hidden="true">
                        {%- case section.settings.bar_2_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="custom-sb__item" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_2_separator != 'none' -%}
                      <span class="custom-sb__separator" aria-hidden="true">
                        {%- case section.settings.bar_2_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Group 2 (Continuous loop duplicate) {%- endcomment -%}
        <div class="custom-sb__group" aria-hidden="true">
          {%- for r in (1..repeat_count_2) -%}
            {%- for block in bar_2_blocks -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" tabindex="-1" class="custom-sb__item">
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_2_separator != 'none' -%}
                      <span class="custom-sb__separator">
                        {%- case section.settings.bar_2_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="custom-sb__item">
                    <span>{{ block.settings.text }}</span>
                    {%- if section.settings.bar_2_separator != 'none' -%}
                      <span class="custom-sb__separator">
                        {%- case section.settings.bar_2_separator -%}
                          {%- when 'dot' -%}•
                          {%- when 'diamond' -%}◆
                          {%- when 'star' -%}★
                          {%- when 'slash' -%}/
                          {%- when 'dash' -%}—
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Custom Scrolling Bars",
  "tag": "section",
  "class": "section-custom-scrolling-bars",
  "settings": [
    {
      "type": "header",
      "content": "=== Scrolling Bar 1 Settings ==="
    },
    {
      "type": "checkbox",
      "id": "bar_1_enabled",
      "label": "Enable Scrolling Bar 1",
      "default": true
    },
    {
      "type": "color",
      "id": "bar_1_bg",
      "label": "Banner Background Color",
      "default": "#1b3b22"
    },
    {
      "type": "color",
      "id": "bar_1_text_color",
      "label": "Text & Separator Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bar_1_padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Banner Size (Vertical Padding)",
      "default": 10
    },
    {
      "type": "range",
      "id": "bar_1_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Desktop Text Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "bar_1_font_size_mobile",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile Text Size",
      "default": 11
    },
    {
      "type": "select",
      "id": "bar_1_font_family",
      "label": "Font Family",
      "options": [
        { "value": "body", "label": "Theme Body Font" },
        { "value": "heading", "label": "Theme Heading Font" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "bar_1_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra-Bold (800)" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "bar_1_text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "none", "label": "Normal (As typed)" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize Each Word" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "bar_1_letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "bar_1_speed",
      "min": 10,
      "max": 240,
      "step": 5,
      "unit": "s",
      "label": "Marquee Speed Duration (Higher = Slower)",
      "default": 80
    },
    {
      "type": "select",
      "id": "bar_1_direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "normal", "label": "Right to Left (Standard)" },
        { "value": "reverse", "label": "Left to Right" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "bar_1_pause_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_1_gap",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 40
    },
    {
      "type": "select",
      "id": "bar_1_separator",
      "label": "Separator Symbol",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "dot", "label": "Dot (•)" },
        { "value": "diamond", "label": "Diamond (◆)" },
        { "value": "star", "label": "Star (★)" },
        { "value": "slash", "label": "Slash (/)" },
        { "value": "dash", "label": "Dash (—)" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "=== Scrolling Bar 2 Settings ==="
    },
    {
      "type": "checkbox",
      "id": "bar_2_enabled",
      "label": "Enable Scrolling Bar 2",
      "default": true
    },
    {
      "type": "color",
      "id": "bar_2_bg",
      "label": "Banner Background Color",
      "default": "#faf5ee"
    },
    {
      "type": "color",
      "id": "bar_2_text_color",
      "label": "Text & Separator Color",
      "default": "#1f3e2c"
    },
    {
      "type": "range",
      "id": "bar_2_padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Banner Size (Vertical Padding)",
      "default": 12
    },
    {
      "type": "range",
      "id": "bar_2_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Desktop Text Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "bar_2_font_size_mobile",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile Text Size",
      "default": 12
    },
    {
      "type": "select",
      "id": "bar_2_font_family",
      "label": "Font Family",
      "options": [
        { "value": "body", "label": "Theme Body Font" },
        { "value": "heading", "label": "Theme Heading Font" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "bar_2_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra-Bold (800)" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "bar_2_text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "none", "label": "Normal (As typed)" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize Each Word" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "bar_2_letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 1.0
    },
    {
      "type": "range",
      "id": "bar_2_speed",
      "min": 10,
      "max": 240,
      "step": 5,
      "unit": "s",
      "label": "Marquee Speed Duration (Higher = Slower)",
      "default": 75
    },
    {
      "type": "select",
      "id": "bar_2_direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "normal", "label": "Right to Left (Standard)" },
        { "value": "reverse", "label": "Left to Right" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "bar_2_pause_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_2_gap",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 36
    },
    {
      "type": "select",
      "id": "bar_2_separator",
      "label": "Separator Symbol",
