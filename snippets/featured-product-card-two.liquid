{%- comment -%}
  Hussain Dairy — Premium 2-Product Card Snippet
  Accepts:
  - product: {Object} Liquid product object
  - section_id: {String} Section ID for isolated element IDs
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'fp2-form-' | append: section_id | append: '-' | append: product.id
  assign has_secondary_image = false
  if product.media.size > 1
    assign has_secondary_image = true
  endif

  # Calculate discount percentage if on sale
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
    assign savings = current_variant.compare_at_price | minus: current_variant.price
    assign savings_percent = savings | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  # Review rating
  assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign review_count = product.metafields.reviews.rating_count | default: 0
-%}

<div class="fp2__card" data-product-id="{{ product.id }}" id="fp2-card-{{ product.id }}">

  {%- comment -%} Media / Images {%- endcomment -%}
  <div class="fp2__media-wrap">
    {%- if on_sale -%}
      <span class="fp2__badge-sale" id="fp2-badge-sale-{{ product.id }}">
        Save {{ savings_percent }}%
      </span>
    {%- endif -%}

    {%- unless current_variant.available -%}
      <span class="fp2__badge-soldout" id="fp2-badge-soldout-{{ product.id }}">
        Sold Out
      </span>
    {%- endunless -%}

    <a href="{{ product.url }}" class="fp2__media-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 700 }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          class="fp2__media-img {% if has_secondary_image %}primary-has-secondary{% endif %}"
          loading="lazy"
          width="700"
          height="700"
        >
        {%- if has_secondary_image -%}
          <img
            src="{{ product.media[1] | image_url: width: 700 }}"
            alt="{{ product.media[1].alt | default: product.title | escape }}"
            class="fp2__media-img secondary-img"
            loading="lazy"
            width="700"
            height="700"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'fp2__media-img' }}
      {%- endif -%}
    </a>
  </div>

  {%- comment -%} Card Content {%- endcomment -%}
  <div class="fp2__content">

    {%- comment -%} Product Title {%- endcomment -%}
    <h3 class="fp2__product-title-wrap" style="margin: 0 0 6px 0;">
      <a href="{{ product.url }}" class="fp2__product-title">{{ product.title }}</a>
    </h3>

    {%- comment -%} Star Ratings {%- endcomment -%}
    <div class="fp2__rating">
      <span class="fp2__stars" aria-label="5 out of 5 stars">★★★★★</span>
      {%- if review_count > 0 -%}
        <span class="fp2__review-count">({{ review_count }})</span>
      {%- else -%}
        <span class="fp2__review-count">(100% Pure Tested)</span>
      {%- endif -%}
    </div>

    {%- comment -%} Price {%- endcomment -%}
    <div class="fp2__price-box">
      <span class="fp2__price-current" id="fp2-price-{{ product.id }}">
        {{ current_variant.price | money }}
      </span>
      {%- if on_sale -%}
        <span class="fp2__price-compare" id="fp2-compare-{{ product.id }}">
          {{ current_variant.compare_at_price | money }}
        </span>
      {%- endif -%}
    </div>

    {%- comment -%} Variants Pill Selector (Size/Weight) {%- endcomment -%}
    {%- if product.variants.size > 1 -%}
      <div class="fp2__variants-wrap" role="group" aria-label="Choose Size">
        {%- for variant in product.variants -%}
          <button
            type="button"
            class="fp2__variant-btn {% if variant.id == current_variant.id %}active{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-price="{{ variant.price | money }}"
            data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
            data-available="{{ variant.available }}"
            onclick="fp2SelectVariant(this, '{{ product.id }}', '{{ product_form_id }}')"
          >
            {{ variant.title }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Add to Cart Form {%- endcomment -%}
    <div class="fp2__cta-wrap">
      <product-form class="product-form" data-section-id="{{ section_id }}">
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="svg-wrapper">
            {{- 'icon-error.svg' | inline_asset_content -}}
          </span>
          <span class="product-form__error-message"></span>
        </div>

        {%- form 'product',
          product,
          id: product_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
            class="product-variant-id"
            id="fp2-variant-id-{{ product.id }}"
            {% if current_variant.available == false %}disabled{% endif %}
          >

          <button
            id="{{ product_form_id }}-submit"
            type="submit"
            name="add"
            class="fp2__btn-submit"
            aria-haspopup="dialog"
            aria-live="polite"
            {% if current_variant.available == false %}disabled{% endif %}
          >
            <span class="fp2__btn-text">
              {%- if current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </span>
            <span class="sold-out-message hidden">Sold Out</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>

      <a href="{{ product.url }}" class="fp2__view-details">
        View Full Details →
      </a>
    </div>

  </div>
</div>

{%- comment -%} Lightweight Variant Switcher Handler {%- endcomment -%}
<script>
  if (typeof fp2SelectVariant === 'undefined') {
    function fp2SelectVariant(btn, productId, formId) {
      const card = document.getElementById('fp2-card-' + productId);
      if (!card) return;

      // Toggle active button
      const allBtns = card.querySelectorAll('.fp2__variant-btn');
      allBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const variantId = btn.getAttribute('data-variant-id');
      const priceText = btn.getAttribute('data-price');
      const comparePriceText = btn.getAttribute('data-compare-price');
      const isAvailable = btn.getAttribute('data-available') === 'true';

      // Update hidden input ID
      const inputId = document.getElementById('fp2-variant-id-' + productId);
      if (inputId) {
        inputId.value = variantId;
        inputId.disabled = !isAvailable;
      }

      // Update Price display
      const priceEl = document.getElementById('fp2-price-' + productId);
      if (priceEl && priceText) {
        priceEl.textContent = priceText;
      }

      // Update Compare Price
      let compareEl = document.getElementById('fp2-compare-' + productId);
      if (comparePriceText) {
        if (!compareEl) {
          compareEl = document.createElement('span');
          compareEl.id = 'fp2-compare-' + productId;
          compareEl.className = 'fp2__price-compare';
          priceEl.parentNode.appendChild(compareEl);
        }
        compareEl.textContent = comparePriceText;
        compareEl.style.display = 'inline';
      } else if (compareEl) {
        compareEl.style.display = 'none';
      }

      // Update Button State
      const submitBtn = document.getElementById(formId + '-submit');
      if (submitBtn) {
        const btnText = submitBtn.querySelector('.fp2__btn-text');
        if (isAvailable) {
          submitBtn.removeAttribute('disabled');
          if (btnText) btnText.textContent = 'Add to Cart';
        } else {
          submitBtn.setAttribute('disabled', 'true');
          if (btnText) btnText.textContent = 'Sold Out';
        }
      }
    }
  }
</script>

